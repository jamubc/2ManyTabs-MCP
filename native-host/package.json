{
  "name": "2manytabs-mcp-host",
  "version": "3.0.0",
  "description": "MCP server that exposes Chrome and Firefox tabs via the 2ManyTabs MCP extension",
  "type": "module",
  "main": "host.js",
  "bin": {
    "2manytabs-mcp": "host.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamubc/2ManyTabs-MCP.git"
  },
  "homepage": "https://github.com/jamubc/2ManyTabs-MCP#readme",
  "files": [
    "host.js",
    "bridge.js",
    "lib/tabs.js",
    "tools/"
  ],
  "scripts": {
    "start": "node host.js",
    "test":  "node --test lib/tabs.test.js lib/background.test.js",
    "test:multibrowser": "MANYTABS_BRIDGE_PORT=19878 node test/multibrowser.js",
    "lint":  "eslint .",
    "prepack": "cp ../README.md ../LICENSE .",
    "postpack": "rm -f README.md LICENSE"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint":     "^9.0.0",
    "globals":    "^15.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
